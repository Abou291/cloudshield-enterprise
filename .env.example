CLOUDSHIELD_ENV=development
CLOUDSHIELD_DATABASE_URL=sqlite:///./cloudshield.db
CLOUDSHIELD_CORS_ORIGINS=["http://localhost:5173"]
CLOUDSHIELD_DEMO_MODE=true
# Authenticated deployment: set DEMO_MODE=false and configure hashed API keys.
# See docs/security-foundation.md. Never put raw API tokens in Git.
CLOUDSHIELD_API_KEYS=[]
CLOUDSHIELD_AWS_CONNECTIONS={}
CLOUDSHIELD_AWS_REGION=eu-west-3
# Optional: role assumed by the API for read-only AWS scans.
CLOUDSHIELD_AWS_ROLE_ARN=
