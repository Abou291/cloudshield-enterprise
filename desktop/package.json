{
  "name": "aegisshield-desktop",
  "version": "0.8.1",
  "private": true,
  "description": "AegisShield \u2014 audit AWS et corrections guid\u00e9es",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "package:win": "npm run build:ui && electron-builder --win nsis",
    "build:ui": "npm --prefix ../frontend run build:desktop"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "playwright": "1.61.1"
  },
  "build": {
    "appId": "com.abou291.aegisshield",
    "productName": "AegisShield",
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "ui"
      },
      {
        "from": "../backend/dist",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AegisShield",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asar": true,
    "artifactName": "AegisShield-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    }
  }
}
